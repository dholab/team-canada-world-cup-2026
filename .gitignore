# uv / Python environment
.venv/
__pycache__/
*.pyc
.uvcache/
.uv/
.pytest_cache/

# Quarto / build outputs
_site/
.quarto/
*.tex
# …but house-preamble.tex is a tracked SOURCE file (the PDF's house-style
# header, referenced by _quarto.yml), not transient Quarto output.
!house-preamble.tex

# House display fonts (Gelasio statics), rebuilt from upstream by
# scripts/build_house_fonts.py on each build; not committed.
fonts/

# Generated figures. Static PNGs are committed (the PDF build needs them and
# they render on GitHub); interactive HTML and intermediate PDFs are rebuilt in
# CI from analysis/data/ and are not tracked.
analysis/figures/*.html
analysis/figures/*.pdf

# macOS
.DS_Store

/.quarto/

# Editable Illustrator masters live in Google Drive, not the repo (only the
# rendered PNG/PDF exports are committed).
*.ai
