fonts/

# Generated figures (rebuilt in CI from analysis/data/).
# The static PNGs and the timeline SVG are committed on purpose so they render
# in PREVIEW.md on GitHub while the interactive Pages site is held back.
analysis/figure1_interactive.html
analysis/figure1_static.pdf
analysis/figure2_houston.pdf
analysis/figure2_houston_interactive.html
analysis/figure3_wastewater.pdf
analysis/figure3_wastewater_interactive.html

